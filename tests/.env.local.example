# Copy to tests/.env.local (it is in .gitignore) and fill in.
# Both users must already exist on the instance under test.

# address of the instance under test
ROOCMS_TEST_URL=
# 1 = do not verify TLS certificate (self-signed)
#ROOCMS_TEST_INSECURE=1

# existing user with role "a" (or "su")
ROOCMS_TEST_ADMIN_LOGIN=
ROOCMS_TEST_ADMIN_PASSWORD=

# existing user with role "m"
ROOCMS_TEST_MODERATOR_LOGIN=
ROOCMS_TEST_MODERATOR_PASSWORD=
