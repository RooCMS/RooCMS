{
  "info": {
    "name": "RooCMS API",
    "description": "REST API for RooCMS (aligned with router + swagger)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    { "key": "base_url", "value": "https://dev.roocms.com/api" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "user_id", "value": "1" },
    { "key": "media_id", "value": "1" },
    { "key": "structure_id", "value": "1" },
    { "key": "slug", "value": "home" },
    { "key": "filename", "value": "backup.sql.gz" },
    { "key": "verification_code", "value": "" }
  ],
  "item": [
    {
      "name": "API Info & Health",
      "item": [
        { "name": "API info", "request": { "method": "GET", "url": "{{base_url}}/" } },
        { "name": "Health", "request": { "method": "GET", "url": "{{base_url}}/v1/health" } },
        { "name": "Health details", "request": { "method": "GET", "url": "{{base_url}}/v1/health/details" } }
      ]
    },
    {
      "name": "Security",
      "item": [
        {
          "name": "CSP report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"csp-report\":{}}" },
            "url": "{{base_url}}/v1/csp-report"
          }
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        { "name": "Public settings", "request": { "method": "GET", "url": "{{base_url}}/v1/settings" } },
        { "name": "ACP settings", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/settings" } },
        { "name": "ACP settings meta", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/settings/meta" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        { "name": "Login", "request": { "method": "POST", "header":[{"key":"Content-Type","value":"application/json"}], "body":{"mode":"raw","raw":"{\"login\":\"user\",\"password\":\"secret\"}"}, "url": "{{base_url}}/v1/auth/login" } },
        { "name": "Register", "request": { "method": "POST", "header":[{"key":"Content-Type","value":"application/json"}], "body":{"mode":"raw","raw":"{\"login\":\"new\",\"email\":\"new@example.com\",\"password\":\"secret\",\"password_confirm\":\"secret\"}"}, "url": "{{base_url}}/v1/auth/register" } },
        { "name": "Refresh", "request": { "method": "POST", "header":[{"key":"Content-Type","value":"application/json"}], "body":{"mode":"raw","raw":"{\"refresh_token\":\"{{refresh_token}}\"}"}, "url": "{{base_url}}/v1/auth/refresh" } },
        { "name": "Revoke refresh", "request": { "method": "POST", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/auth/refresh/revoke" } },
        { "name": "Logout", "request": { "method": "POST", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/auth/logout" } },
        { "name": "Logout all", "request": { "method": "POST", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/auth/logout/all" } },
        { "name": "Password recovery", "request": { "method": "POST", "header":[{"key":"Content-Type","value":"application/json"}], "body":{"mode":"raw","raw":"{\"email\":\"user@example.com\"}"}, "url": "{{base_url}}/v1/auth/password/recovery" } },
        { "name": "Password reset", "request": { "method": "POST", "header":[{"key":"Content-Type","value":"application/json"}], "body":{"mode":"raw","raw":"{\"email\":\"user@example.com\",\"code\":\"123456\",\"password\":\"newpass\"}"}, "url": "{{base_url}}/v1/auth/password/reset" } },
        { "name": "Password update", "request": { "method": "PUT", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"current_password\":\"old\",\"password\":\"new\"}"}, "url": "{{base_url}}/v1/auth/password" } }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "List users", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/users" } },
        { "name": "User by id", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/users/{{user_id}}" } },
        { "name": "Me", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/users/me" } },
        { "name": "Update me", "request": { "method": "PATCH", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"name\":\"New Name\"}"}, "url": "{{base_url}}/v1/users/me" } },
        { "name": "Delete me", "request": { "method": "DELETE", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/users/me" } },
        { "name": "Upload avatar", "request": { "method": "POST", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":""}]}, "url": "{{base_url}}/v1/users/me/avatar" } },
        { "name": "Delete avatar", "request": { "method": "DELETE", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/users/me/avatar" } },
        { "name": "Request verify email", "request": { "method": "POST", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/users/me/verify-email" } },
        { "name": "Verify email by code", "request": { "method": "GET", "url": "{{base_url}}/v1/users/verify-email/{{verification_code}}" } }
      ]
    },
    {
      "name": "Media",
      "item": [
        { "name": "List media", "request": { "method": "GET", "url": "{{base_url}}/v1/media" } },
        { "name": "Get media", "request": { "method": "GET", "url": "{{base_url}}/v1/media/{{media_id}}" } },
        { "name": "Download file", "request": { "method": "GET", "url": "{{base_url}}/v1/media/{{media_id}}/file" } },
        { "name": "Upload media", "request": { "method": "POST", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":""}]}, "url": "{{base_url}}/v1/media/upload" } },
        { "name": "Update media", "request": { "method": "PUT", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"description\":\"updated\"}"}, "url": "{{base_url}}/v1/media/{{media_id}}" } },
        { "name": "Delete media", "request": { "method": "DELETE", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/media/{{media_id}}" } }
      ]
    },
    {
      "name": "Structure (public)",
      "item": [
        { "name": "Tree", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/tree" } },
        { "name": "Page by id", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/page/{{structure_id}}" } },
        { "name": "Page by slug", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/page/slug/{{slug}}" } },
        { "name": "Navigation", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/navigation" } },
        { "name": "Breadcrumbs by id", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/breadcrumbs/{{structure_id}}" } },
        { "name": "Breadcrumbs by slug", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/breadcrumbs/slug/{{slug}}" } },
        { "name": "SEO by id", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/seo/{{structure_id}}" } },
        { "name": "SEO by slug", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/seo/slug/{{slug}}" } },
        { "name": "Current", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/current" } },
        { "name": "Search", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/search" } },
        { "name": "By status", "request": { "method": "GET", "url": "{{base_url}}/v1/structure/status/published" } }
      ]
    },
    {
      "name": "ACP Structure",
      "item": [
        { "name": "List", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/structure" } },
        { "name": "Create", "request": { "method": "POST", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"title\":\"New page\",\"slug\":\"new-page\"}"}, "url": "{{base_url}}/v1/acp/structure" } },
        { "name": "Show", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/structure/{{structure_id}}" } },
        { "name": "Update", "request": { "method": "PUT", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"title\":\"Updated\"}"}, "url": "{{base_url}}/v1/acp/structure/{{structure_id}}" } },
        { "name": "Delete", "request": { "method": "DELETE", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/structure/{{structure_id}}" } },
        { "name": "Change status", "request": { "method": "PATCH", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"status\":\"published\"}"}, "url": "{{base_url}}/v1/acp/structure/{{structure_id}}/status" } },
        { "name": "Reorder", "request": { "method": "PUT", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"items\":[{\"id\":1,\"position\":1}]}"}, "url": "{{base_url}}/v1/acp/structure/reorder" } }
      ]
    },
    {
      "name": "ACP Users",
      "item": [
        { "name": "Roles", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/users/roles" } },
        { "name": "Show user", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/users/{{user_id}}" } },
        { "name": "Update user", "request": { "method": "PUT", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"email\":\"new@example.com\"}"}, "url": "{{base_url}}/v1/acp/users/{{user_id}}" } },
        { "name": "Delete user", "request": { "method": "DELETE", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/users/{{user_id}}" } },
        { "name": "Change password", "request": { "method": "PUT", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"password\":\"new\"}"}, "url": "{{base_url}}/v1/acp/users/{{user_id}}/password" } },
        { "name": "Change role", "request": { "method": "PATCH", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"role\":\"a\"}"}, "url": "{{base_url}}/v1/acp/users/{{user_id}}/role" } },
        { "name": "Activate", "request": { "method": "PATCH", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/users/{{user_id}}/activate" } },
        { "name": "Deactivate", "request": { "method": "PATCH", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/users/{{user_id}}/deactivate" } },
        { "name": "Verify", "request": { "method": "PATCH", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/users/{{user_id}}/verify" } },
        { "name": "Unverify", "request": { "method": "PATCH", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/users/{{user_id}}/unverify" } },
        { "name": "Delete avatar (admin)", "request": { "method": "DELETE", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/users/{{user_id}}/avatar" } }
      ]
    },
    {
      "name": "Moderation",
      "item": [
        { "name": "Ban user", "request": { "method": "POST", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"until\":1737552000,\"reason\":\"violation\"}"}, "url": "{{base_url}}/v1/moderate/ban/{{user_id}}" } },
        { "name": "Unban user", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/moderate/unban/{{user_id}}" } }
      ]
    },
    {
      "name": "Backup",
      "item": [
        { "name": "Status", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/backup/status" } },
        { "name": "List", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/backup/list" } },
        { "name": "Create", "request": { "method": "POST", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/backup/create" } },
        { "name": "Restore", "request": { "method": "POST", "header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{access_token}}"}], "body":{"mode":"raw","raw":"{\"filename\":\"{{filename}}\"}"}, "url": "{{base_url}}/v1/backup/restore" } },
        { "name": "Delete", "request": { "method": "DELETE", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/backup/delete/{{filename}}" } },
        { "name": "Download", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/backup/download/{{filename}}" } },
        { "name": "Logs", "request": { "method": "GET", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/backup/logs" } }
      ]
    },
    {
      "name": "Debug",
      "item": [
        { "name": "Clear debug logs", "request": { "method": "POST", "header":[{"key":"Authorization","value":"Bearer {{access_token}}"}], "url": "{{base_url}}/v1/acp/debug/clear" } }
      ]
    }
  ]
}
